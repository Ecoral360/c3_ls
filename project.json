{
  "authors": [
    "m0tholith",
    "Zathy",
    "ecoral360"
  ],
  "cpu": "generic",
  "dependencies": [
    "dessert",
    "c3_analyzer"
  ],
  "dependency-search-paths": [
    "lib/"
  ],
  "langrev": "1",
  "opt": "O0",
  "output": "build",
  "sources": [
    "src/**"
  ],
  "targets": {
    "c3_ls": {
      "features": [
        "SEMA"
      ],
      "type": "executable"
    }
  },
  "test-sources": [
    "test/**"
  ],
  "version": "0.1.0",
  "warnings": [
    "no-unused"
  ]
}
